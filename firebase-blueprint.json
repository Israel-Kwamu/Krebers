{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles and account settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "userCarts": {
      "title": "User Carts",
      "description": "Shopping carts saved by user ID",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "userWishlists": {
      "title": "User Wishlists",
      "description": "Saved wishlist products per user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "orders": {
      "title": "User Orders",
      "description": "Order history per user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "shippingAddress": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "items", "total"]
    }
  }
}
